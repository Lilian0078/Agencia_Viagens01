@model Agencia_Viagens01.Models.Produto

<div class="container mt-5">
    <div class="card border-danger">
        <div class="card-header bg-danger text-white">
            <h2>Excluir Produto</h2>
        </div>
        <div class="card-body">
            <h4 class="text-danger">Tem certeza que deseja excluir este produto?</h4>
            <hr />

            <dl class="row">
                <dt class="col-sm-3">Código:</dt>
                <dd class="col-sm-9">@Model.Codigo</dd>

                <dt class="col-sm-3">Descrição:</dt>
                <dd class="col-sm-9">@Model.Descricao</dd>
            </dl>

            <form action="/Produto/ExcluirConfirmado" method="post">
                <input type="hidden" name="Codigo" value="@Model.Codigo" />

                <button type="submit" class="btn btn-danger">Sim, Excluir</button>
                <a href="/Produto/Index" class="btn btn-secondary">Cancelar</a>
            </form>
        </div>
    </div>
</div>
