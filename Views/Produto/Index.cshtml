@model IEnumerable<Agencia_Viagens01.Models.Produto>

<div class="container mt-5">
    <h2 class="mb-4">Lista de Produtos</h2>

    <p>
        <a href="/Produto/Criar" class="btn btn-success">Cadastrar Novo Produto</a>
    </p>

    <table class="table table-bordered table-hover">
        <thead class="thead-dark">
            <tr>
                <th>Código</th>
                <th>Descrição</th>
                <th>Ações</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr id="linha-@item.Codigo">
                    <td>@item.Codigo</td>
                    <td>@item.Descricao</td>
                    <td>
                        <a href="/Produto/Editar/@item.Codigo" class="btn btn-sm btn-primary">Editar</a>

                        <button type="button" class="btn btn-danger"
                                onclick="abrirModalExcluir(@item.Codigo, '@item.Descricao')">
                            Excluir
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="modal fade" id="modalExcluir" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Confirmar Exclusão</h5>
            </div>

            <div class="modal-body">
                <p>
                    Tem certeza que deseja excluir o produto
                    <strong id="descricaoProdutoModal"></strong>?
                </p>

                <input type="hidden" id="idProdutoExcluir" />
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    Cancelar
                </button>

                <button type="button" class="btn btn-danger" onclick="confirmarExclusao()">
                    Sim, Excluir
                </button>
            </div>

        </div>
    </div>
</div>

<script>
    function abrirModalExcluir(id, descricao) {
        $('#idProdutoExcluir').val(id);
        $('#descricaoProdutoModal').text(descricao);
        $('#modalExcluir').modal('show');
    }

    function confirmarExclusao() {
        var id = $('#idProdutoExcluir').val();

        $.ajax({
            url: '/Produto/ExcluirConfirmadoModal',
            type: 'POST',
            data: { Codigo: id },

            success: function (result) {
                if (result.success) {
                    $('#modalExcluir').modal('hide');

                    $('#linha-' + id).fadeOut(500, function () {
                        $(this).remove();
                    });
                } else {
                    alert(result.message);
                }
            },

            error: function () {
                alert("Erro técnico ao tentar excluir.");
            }
        });
    }
</script>
