@model IEnumerable<Agencia_Viagens01.Models.Compra>

<div class="container mt-5">

    <h2 class="mb-4">
        Lista de Compras
    </h2>

    <p>
        <a href="/Compra/Criar"
           class="btn btn-success">
            Cadastrar Nova Compra
        </a>
    </p>

    <table class="table table-bordered table-hover">

        <thead class="thead-dark">

            <tr>
                <th>Código</th>
                <th>Data da Compra</th>
                <th>Forma de Pagamento</th>
                <th>Valor Total</th>
                <th>Ações</th>
            </tr>

        </thead>

        <tbody>

            @foreach (var item in Model)
            {
                <tr id="linha-@item.Codigo">

                    <td>
                        @item.Codigo
                    </td>

                    <td>
                        @(item.DataCompra.ToString("dd/MM/yyyy") )
                    </td>

                    <td>
                        @item.FormaPagamento
                    </td>

                    <td>
                        @(item.ValorTotal.ToString("C2") )
                    </td>

                    <td>

                        <a href="/Compra/Editar/@item.Codigo"
                           class="btn btn-sm btn-primary">
                            Editar
                        </a>

                        <button type="button"
                                class="btn btn-sm btn-danger"
                                onclick="abrirModalExcluir(
                                    @item.Codigo,
                                    '@item.FormaPagamento'
                                )">
                            Excluir
                        </button>

                    </td>

                </tr>
            }

        </tbody>

    </table>

</div>


<!-- MODAL DE EXCLUSÃO -->

<div class="modal fade"
     id="modalExcluir"
     tabindex="-1"
     role="dialog">

    <div class="modal-dialog"
         role="document">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title">
                    Confirmar Exclusão
                </h5>

            </div>

            <div class="modal-body">

                <p>
                    Tem certeza que deseja excluir esta compra?
                </p>

                <strong id="formaPagamentoModal"></strong>

                <input type="hidden"
                       id="idCompraExcluir" />

            </div>

            <div class="modal-footer">

                <button type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">
                    Cancelar
                </button>

                <button type="button"
                        class="btn btn-danger"
                        onclick="confirmarExclusao()">
                    Sim, Excluir
                </button>

            </div>

        </div>

    </div>

</div>


<script>

    function abrirModalExcluir(id, formaPagamento) {

        $('#idCompraExcluir').val(id);

        $('#formaPagamentoModal').text(
            "Forma de pagamento: " + formaPagamento
        );

        $('#modalExcluir').modal('show');
    }


    function confirmarExclusao() {

        var id = $('#idCompraExcluir').val();

        $.ajax({

            url: '/Compra/ExcluirConfirmadoModal',

            type: 'POST',

            data: {
                Codigo: id
            },

            success: function (result) {

                if (result.success) {

                    $('#modalExcluir').modal('hide');

                    $('#linha-' + id).fadeOut(
                        500,
                        function () {
                            $(this).remove();
                        }
                    );

                }
                else {

                    alert(result.message);

                }

            },

            error: function () {

                alert(
                    "Erro técnico ao tentar excluir a compra."
                );

            }

        });

    }

</script>
