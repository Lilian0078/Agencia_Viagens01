@model IEnumerable<Agencia_Viagens01.Models.PacoteViagem>

<div class="container mt-5">

    <h2 class="mb-4">Lista de Pacotes de Viagem</h2>

    <p>
        <a href="/PacoteViagem/Criar"
           class="btn btn-success">
            Cadastrar Novo Pacote
        </a>
    </p>

    <table class="table table-bordered table-hover">

        <thead class="thead-dark">
            <tr>
                <th>Código</th>
                <th>Origem</th>
                <th>Destino</th>
                <th>Data Início</th>
                <th>Data Final</th>
                <th>Valor Total</th>
                <th>Ações</th>
            </tr>
        </thead>

        <tbody>

            @foreach (var item in Model)
            {
                <tr id="linha-@item.Codigo">

                    <td>
                        @item.Codigo
                    </td>

                    <td>
                        @item.Origem
                    </td>

                    <td>
                        @item.Destino
                    </td>

                    <td>
                        @(item.DataInicio.ToString("dd/MM/yyyy"))
                    </td>

                    <td>
                        @(item.DataFinal.ToString("dd/MM/yyyy"))
                    </td>

                    <td>
                        @(item.ValorTotal.ToString("C2"))
                    </td>

                    <td>

                        <a href="/PacoteViagem/Editar/@item.Codigo"
                           class="btn btn-sm btn-primary">
                            Editar
                        </a>

                        <button type="button"
                                class="btn btn-sm btn-danger"
                                onclick="abrirModalExcluir(
                                    @item.Codigo,
                                    '@item.Origem',
                                    '@item.Destino'
                                )">
                            Excluir
                        </button>

                    </td>

                </tr>
            }

        </tbody>

    </table>

</div>


<!-- MODAL DE EXCLUSÃO -->

<div class="modal fade"
     id="modalExcluir"
     tabindex="-1"
     role="dialog">

    <div class="modal-dialog"
         role="document">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title">
                    Confirmar Exclusão
                </h5>

            </div>

            <div class="modal-body">

                <p>
                    Tem certeza que deseja excluir o pacote:
                </p>

                <strong id="pacoteModal"></strong>

                <input type="hidden"
                       id="idPacoteExcluir" />

            </div>

            <div class="modal-footer">

                <button type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">
                    Cancelar
                </button>

                <button type="button"
                        class="btn btn-danger"
                        onclick="confirmarExclusao()">
                    Sim, Excluir
                </button>

            </div>

        </div>

    </div>

</div>


<script>

    function abrirModalExcluir(id, origem, destino) {

        $('#idPacoteExcluir').val(id);

        $('#pacoteModal').text(
            origem + " → " + destino
        );

        $('#modalExcluir').modal('show');
    }


    function confirmarExclusao() {

        var id = $('#idPacoteExcluir').val();

        $.ajax({

            url: '/PacoteViagem/ExcluirConfirmadoModal',

            type: 'POST',

            data: {
                Codigo: id
            },

            success: function (result) {

                if (result.success) {

                    $('#modalExcluir').modal('hide');

                    $('#linha-' + id).fadeOut(
                        500,
                        function () {
                            $(this).remove();
                        }
                    );

                }
                else {

                    alert(result.message);

                }

            },

            error: function () {

                alert(
                    "Erro técnico ao tentar excluir o pacote."
                );

            }

        });

    }

</script>