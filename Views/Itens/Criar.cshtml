@model Agencia_Viagens01.Models.Itens

<div class="container mt-5">
    <div class="card">
        <div class="card-header bg-success text-white">
            <h2>Cadastrar Novo Item</h2>
        </div>

        <div class="card-body">
            <form action="/Itens/Criar" method="post">

                <div class="form-group mb-3">
                    <label for="codProduto">Código do Produto</label>
                    <input type="number"
                           id="codProduto"
                           name="CodProduto"
                           class="form-control"
                           required />
                </div>

                <div class="form-group mb-3">
                    <label for="codPacote">Código do Pacote</label>
                    <input type="number"
                           id="codPacote"
                           name="CodPacote"
                           class="form-control"
                           required />
                </div>

                <div class="form-group mb-3">
                    <label for="quantidade">Quantidade</label>
                    <input type="number"
                           id="quantidade"
                           name="Quantidade"
                           class="form-control"
                           required />
                </div>

                <div class="form-group mb-3">
                    <label for="valorUnidade">Valor Unidade</label>
                    <input type="number"
                           id="valorUnidade"
                           name="ValorUnidade"
                           class="form-control"
                           step="0.01"
                           required />
                </div>

                <div class="form-group mt-4">
                    <button type="submit" class="btn btn-primary">
                        Salvar Item
                    </button>

                    <a href="/Itens/Index" class="btn btn-secondary">
                        Voltar para a Lista
                    </a>
                </div>

            </form>
        </div>
    </div>
</div>