@model IEnumerable<Agencia_Viagens01.Models.Itens>

<div class="container mt-5">
    <h2 class="mb-4">Lista de Itens</h2>

    <p>
        <a href="/Itens/Criar" class="btn btn-success">Cadastrar Novo Item</a>
    </p>

    <table class="table table-bordered table-hover">
        <thead class="thead-dark">
            <tr>
                <th>Código</th>
                <th>Código Produto</th>
                <th>Código Pacote</th>
                <th>Quantidade</th>
                <th>Valor Unidade</th>
                <th>Ações</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model)
            {
                <tr id="linha-@item.Codigo">
                    <td>@item.Codigo</td>
                    <td>@item.CodProduto</td>
                    <td>@item.CodPacote</td>
                    <td>@item.Quantidade</td>
                    <td>@item.ValorUnidade.ToString("C2")</td>

                    <td>
                        <a href="/Itens/Editar/@item.Codigo"
                           class="btn btn-sm btn-primary">
                            Editar
                        </a>

                        <button type="button"
                                class="btn btn-danger"
                                onclick="abrirModalExcluir(@item.Codigo, '@item.CodProduto')">
                            Excluir
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Modal de Exclusão -->
<div class="modal fade" id="modalExcluir" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Confirmar Exclusão</h5>
            </div>

            <div class="modal-body">
                <p>
                    Tem certeza que deseja excluir o item do produto
                    <strong id="produtoItemModal"></strong>?
                </p>

                <input type="hidden" id="idItemExcluir" />
            </div>

            <div class="modal-footer">

                <button type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">
                    Cancelar
                </button>

                <button type="button"
                        class="btn btn-danger"
                        onclick="confirmarExclusao()">
                    Sim, Excluir
                </button>

            </div>

        </div>
    </div>
</div>

<script>
    function abrirModalExcluir(id, codProduto) {

        $('#idItemExcluir').val(id);

        $('#produtoItemModal').text(codProduto);

        $('#modalExcluir').modal('show');
    }

    function confirmarExclusao() {

        var id = $('#idItemExcluir').val();

        $.ajax({
            url: '/Itens/ExcluirConfirmadoModal',
            type: 'POST',

            data: {
                Codigo: id
            },

            success: function (result) {

                if (result.success) {

                    $('#modalExcluir').modal('hide');

                    $('#linha-' + id).fadeOut(500, function () {
                        $(this).remove();
                    });

                } else {

                    alert(result.message);
                }
            },

            error: function () {

                alert("Erro técnico ao tentar excluir.");
            }
        });
    }
</script>