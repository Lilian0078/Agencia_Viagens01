@model Agencia_Viagens01.Models.Categoria

<div class="container mt-5">
    <div class="card">
        <div class="card-header bg-primary text-white">
            <h2>Editar Categoria</h2>
        </div>
        <div class="card-body">
            <form action="/Categoria/Editar" method="post">

                <input type="hidden" name="Codigo" value="@Model.Codigo" />

                <div class="form-group mb-3">
                    <label for="hotel">Hotel</label>
                    <input type="text" id="hotel" name="Hotel" class="form-control" value="@Model.Hotel" required />
                </div>

                <div class="form-group mb-3">
                    <label for="aviao">Avião</label>
                    <input type="text" id="aviao" name="Aviao" class="form-control" value="@Model.Aviao" required />
                </div>

                <div class="form-group mb-3">
                    <label for="translado">Translado</label>
                    <input type="text" id="translado" name="Translado" class="form-control" value="@Model.Translado" required />
                </div>

                <div class="form-group mb-3">
                    <label for="voucher">Voucher</label>
                    <input type="text" id="voucher" name="Voucher" class="form-control" value="@Model.Voucher" required />
                </div>

                <div class="form-group mt-4">
                    <button type="submit" class="btn btn-primary">Salvar Alterações</button>
                    <a href="/Categoria/Index" class="btn btn-secondary">Cancelar</a>
                </div>

            </form>
        </div>
    </div>
</div>