@model Agencia_Viagens01.Models.Usuario

<div class="container mt-5">
    <div class="card border-danger">
        <div class="card-header bg-danger text-white">
            <h2>Excluir Usuário</h2>
        </div>
        <div class="card-body">
            <h4 class="text-danger">Tem certeza que deseja excluir este usuário?</h4>
            <hr />

            <dl class="row">
                <dt class="col-sm-3">Código:</dt>
                <dd class="col-sm-9">@Model.Codigo</dd>

                <dt class="col-sm-3">Nome:</dt>
                <dd class="col-sm-9">@Model.Nome</dd>

                <dt class="col-sm-3">Email:</dt>
                <dd class="col-sm-9">@Model.Email</dd>

                <dt class="col-sm-3">Código Funcionário:</dt>
                <dd class="col-sm-9">@Model.CodigoFuncionario</dd>
            </dl>

            <form action="/Usuario/ExcluirConfirmado" method="post">
                <input type="hidden" name="Codigo" value="@Model.Codigo" />

                <button type="submit" class="btn btn-danger">Sim, Excluir</button>
                <a href="/Usuario/Index" class="btn btn-secondary">Cancelar</a>
            </form>
        </div>
    </div>
</div>